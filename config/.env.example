# Copy this file to .env and fill in real values. .env is gitignored.

APP_ENV=production
APP_DEBUG=false

SITE_NAME=FBVideo Downloader
SITE_URL=https://your-domain.example.com

CONTACT_EMAIL=support@your-domain.example.com
PRIVACY_EMAIL=privacy@your-domain.example.com

# Set to true once your AdSense account is approved and you have a publisher ID.
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=

# Leave unset to use the default ./bin/yt-dlp(.exe) location.
YTDLP_BINARY_PATH=

DOWNLOAD_RATE_LIMIT=12
MEDIA_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: report page views + downloads to the Toolzen tools site admin.
# Key must match EXTERNAL_TOOLS_INGEST_KEY in the tools project's .env.
TOOLZEN_EVENTS_URL=https://your-tools-site.example.com/api/external-tools/facebook-video-downloader/events
TOOLZEN_INGEST_KEY=
